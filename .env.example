# =============================================================================
# Sample Browser Configuration
# =============================================================================
# Copy this file to .env and configure the required paths.

# =============================================================================
# REQUIRED: Paths
# =============================================================================

# Application data directory (database, logs) - will be created if needed
# This directory needs read-write access
DATA_PATH=/srv/sample-browser/data

# Audio files directory (your sample library)
# This directory is mounted read-only for security
AUDIO_PATH=/srv/audio/samples

# =============================================================================
# Network and Domain
# =============================================================================

# Docker network name (must exist)
NETWORK_NAME=sample-browser

# Domain for service URLs
DOMAIN=example.com

# Comma-separated origins the API accepts cross-origin requests from. Only
# matters if something calls the API directly (NEXT_PUBLIC_API_URL, /docs, a
# script) rather than through the bundled web app's same-origin proxy. No
# wildcard default; set this to your real origin(s) before exposing the API's
# own port publicly.
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# =============================================================================
# User/Group IDs
# =============================================================================

# User and group IDs for file permissions
# Default 568 matches TrueNAS conventions
PUID=568
PGID=568

# Timezone
TZ=UTC

# =============================================================================
# Application Settings
# =============================================================================

# Log level: debug, info, warning, error
LOG_LEVEL=info

# Scan audio directory on startup
SCAN_ON_STARTUP=true

# Watch for file changes (uses more resources)
WATCH_FOR_CHANGES=false

# =============================================================================
# Port Configuration
# =============================================================================

# Published port for web interface
PUBLISHED_PORT=3000

# Port mode: ingress or host
PORT_MODE=ingress

# =============================================================================
# Traefik Integration (optional)
# =============================================================================

# Enable Traefik reverse proxy
TRAEFIK_ENABLE=true

# Enable TLS
TRAEFIK_TLS=true

# Certificate resolver name
TRAEFIK_CERTRESOLVER=myresolver

# =============================================================================
# Homepage Dashboard (optional)
# =============================================================================

# Dashboard group name
HOMEPAGE_GROUP=Media

# =============================================================================
# Resource Limits
# =============================================================================

# API service limits
API_CPU_LIMIT=2
API_MEMORY_LIMIT=1024M
API_CPU_RESERVATION=0.1
API_MEMORY_RESERVATION=128M

# Web service limits
WEB_CPU_LIMIT=1
WEB_MEMORY_LIMIT=512M
WEB_CPU_RESERVATION=0.1
WEB_MEMORY_RESERVATION=64M

# =============================================================================
# Health Check Settings
# =============================================================================

HEALTHCHECK_INTERVAL=30s
HEALTHCHECK_TIMEOUT=5s
HEALTHCHECK_RETRIES=5
HEALTHCHECK_START_PERIOD=30s

# Restart policy
RESTART_POLICY=unless-stopped
